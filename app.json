{
  "expo": {
    "name": "Kaarya-Siddhi",
    "slug": "Kaarya-Siddhi",
    "scheme": "kaaryasiddhi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-logo.png",
        "backgroundColor": "#192744"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pshlok.KaaryaSiddhi"
    },
    "web": {
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#192744"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1A2744"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "302108ef-f71d-42fe-9837-2b1b4a967552"
      }
    }
  }
}
